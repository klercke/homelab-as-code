{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protonet.internal/schemas/sites.json",
  "title": "ProtoNet site registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["sites"],
  "properties": {
    "sites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{1,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site_index", "name", "slug", "prefix", "status"],
        "properties": {
          "site_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Second octet of the site's /16 within 10.0.0.0/8."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,49}$"
          },
          "prefix": {
            "type": "string",
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[1-2][0-9]|3[0-2])$"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": ["active", "planned", "staging", "decommissioning", "retired"]
          }
        }
      }
    }
  }
}
