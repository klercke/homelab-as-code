{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protonet.internal/schemas/vlans.json",
  "title": "ProtoNet VLAN and prefix registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["vlans"],

  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "ipv4_cidr": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[1-2][0-9]|3[0-2])$"
    },
    "host_octet": {
      "type": "integer",
      "minimum": 1,
      "maximum": 254
    }
  },

  "properties": {
    "vlans": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "fns", "name", "status", "dhcp_v4"],
        "properties": {
          "net_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Derived VLAN. Third octet of the IPv4 prefix, IPv6 subnet ID, and suffix of the 802.1Q tag."
          },
          "vlan_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4094,
            "description": "Override VLAN only. Literal 802.1Q tag. Requires prefix_v4; IPv6 is disabled."
          },
          "prefix_v4": {
            "$ref": "#/$defs/ipv4_cidr",
            "description": "Override VLAN only. Literal IPv4 prefix. Requires vlan_id; IPv6 is disabled."
          },
          "site": {
            "$ref": "#/$defs/slug",
            "description": "Key into sites.yaml."
          },
          "fns": {
            "$ref": "#/$defs/slug",
            "description": "Functional network segment name."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": ["active", "reserved", "deprecated"]
          },
          "dhcp_v4": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "description": "Pool boundaries are host octets within the VLAN prefix. Omitted boundaries use the registry module defaults.",
            "properties": {
              "enabled": { "type": "boolean" },
              "dynamic_start": { "$ref": "#/$defs/host_octet" },
              "dynamic_end": { "$ref": "#/$defs/host_octet" },
              "reservation_start": { "$ref": "#/$defs/host_octet" },
              "reservation_end": { "$ref": "#/$defs/host_octet" }
            },
            "if": {
              "properties": { "enabled": { "const": false } },
              "required": ["enabled"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["dynamic_start"] },
                  { "required": ["dynamic_end"] },
                  { "required": ["reservation_start"] },
                  { "required": ["reservation_end"] }
                ]
              }
            }
          }
        },
        "oneOf": [
          {
            "required": ["net_id"],
            "not": {
              "anyOf": [
                { "required": ["vlan_id"] },
                { "required": ["prefix_v4"] }
              ]
            }
          },
          {
            "required": ["vlan_id", "prefix_v4"],
            "not": { "required": ["net_id"] }
          }
        ]
      }
    }
  }
}
