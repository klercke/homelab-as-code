{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protonet.internal/schemas/hosts.json",
  "title": "ProtoNet managed host registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["hosts"],
  "properties": {
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{1,14}[0-9]{2}$",
        "description": "Functional name: role slug followed by a two-digit ordinal."
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vlan",
          "host_octet",
          "layer",
          "role",
          "crit",
          "node",
          "cores",
          "memory",
          "disk"
        ],
        "properties": {
          "vlan": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,30}$",
            "description": "Key into vlans.yaml. Determines address and VMID."
          },
          "host_octet": {
            "type": "integer",
            "minimum": 10,
            "maximum": 49,
            "description": "Fourth octet. Statically addressed infrastructure range only; .100+ is DHCP."
          },
          "layer": {
            "enum": ["l0", "l1", "l2"],
            "description": "l0 substrate, l1 source-of-truth services, l2 workloads."
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,30}$"
          },
          "crit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "1 critical infra, 2 infra non-critical, 3 end-user impact, 4 no impact."
          },
          "node": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,30}$",
            "description": "Proxmox node name."
          },
          "cores": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "memory": {
            "type": "integer",
            "minimum": 2048,
            "maximum": 262144,
            "description": "MiB. Floor of 2048: dnf transactions OOM below roughly 1.7 GiB usable."
          },
          "disk": {
            "type": "integer",
            "minimum": 16,
            "maximum": 2048,
            "description": "OS disk size in GiB"
          },
          "data_disk": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384,
            "description": "Optional second disk in GiB for service data. Survives OS rebuild."
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
