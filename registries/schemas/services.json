{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protonet.internal/schemas/services.json",
  "title": "ProtoNet service registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["role_services", "public_services"],

  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protocol", "ports"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "protocol": {
          "enum": ["tcp", "udp", "sctp"],
          "description": "NetBox service protocol choices. One entry per protocol; a service on both TCP and UDP needs two."
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "integer", "minimum": 1, "maximum": 65535 },
              {
                "type": "string",
                "pattern": "^[0-9]{1,5}-[0-9]{1,5}$",
                "description": "Inclusive range, e.g. \"27000-27099\". Expanded into single ports for NetBox."
              }
            ]
          }
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },

  "properties": {
    "host_services": {
      "type": "array",
      "description": "Services on every host in hosts.yaml, installed by the base role. Not applied to devices.",
      "items": { "$ref": "#/$defs/service" }
    },

    "role_services": {
      "type": "object",
      "description": "Role key -> list of listening services. Projected into NetBox per host or device holding that role.",
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/service" }
      }
    },

    "public_services": {
      "type": "object",
      "description": "User-facing name -> backend. Internal services become <name>.int.ptxe.dev behind internal Caddy; public ones are served by edge Caddy under their hostname.",
      "propertyNames": {
        "$ref": "#/$defs/slug",
        "description": "Becomes the leftmost label of the public name."
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "port"],
        "properties": {
          "backend": {
            "$ref": "#/$defs/slug",
            "description": "Host key from hosts.yaml or a device key from devices.yaml."
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "scheme": {
            "enum": ["http", "https"],
            "description": "Backend protocol. Defaults to http."
          },
          "exposure": {
            "enum": ["internal", "public"],
            "description": "internal (default): <name>.int.ptxe.dev via Caddy. public: served on the internet by edge Caddy."
          },
          "hostname": {
            "type": "string",
            "pattern": "^([a-z0-9-]+\\.)+ptxe\\.dev$",
            "description": "Public services only. Defaults to <name>.ptxe.dev."
          },
          "routes": {
            "type": "array",
            "description": "Public services only. Paths sent to another port on the same backend; everything else goes to port.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "port"],
              "properties": {
                "path": { "type": "string", "pattern": "^/", "description": "Caddy path matcher, e.g. /upload*." },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        },
        "if": { "not": { "properties": { "exposure": { "const": "public" } }, "required": ["exposure"] } },
        "then": { "not": { "anyOf": [ { "required": ["hostname"] }, { "required": ["routes"] } ] } }
      }
    }
  }
}
