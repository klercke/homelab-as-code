# Managed by Ansible. Local changes will be overwritten.
[Unit]
Description=Immich Postgres
Wants=network-online.target
After=network-online.target

[Container]
Image={{ immich_postgres_image }}
ContainerName=immich-postgres
Network=host
EnvironmentFile={{ immich_config_dir }}/postgres.env
Volume={{ immich_postgres_data_dir }}:/var/lib/postgresql/data:Z
ShmSize=128m

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
