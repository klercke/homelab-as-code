#!/bin/bash
# Managed by Ansible. Local changes will be overwritten.
# Deploys one image tag to one ProtoBot environment.
# CI runs this over SSH through a forced command, so treat every argument as hostile.
set -euo pipefail

env="${1:-}"
tag="${2:-}"

case "$env" in
{% for e in protobot_environments %}
  {{ e }}) ;;
{% endfor %}
  *) echo "unknown environment: $env" >&2; exit 2 ;;
esac

# Only commit tags from main and release versions.
if [[ ! "$tag" =~ ^(sha-[0-9a-f]{12}|[0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  echo "refusing tag: $tag" >&2
  exit 2
fi

# SSH sessions usually set this, but don't depend on it.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"

image="{{ protobot_registry_image }}:$tag"
podman pull --quiet "$image"
podman tag "$image" "localhost/protobot:$env"
systemctl --user restart "protobot-$env"
systemctl --user is-active --quiet "protobot-$env"
echo "protobot-$env now running $tag"
