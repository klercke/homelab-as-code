{# Managed by Ansible. Generated from ansible/group_vars/all/hlac.json. #}
{
	email {{ caddy_acme_email }}

	log {
		output file /var/log/caddy/caddy.log
		format json
	}
}

{% if caddy_mode == 'edge' %}

# One certificate per public hostname, each through DNS-01, so nothing here
# depends on port 80 being reachable. Caddy redirects HTTP to HTTPS, streams
# request bodies (large uploads and Wings transfers), and proxies websockets.
{% for name, svc in hlac.exposed_services | dictsort %}
# {{ svc.description or name }} -> {{ svc.backend }}
{{ svc.hostname }} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

{% for route in svc.routes %}
	handle {{ route.path }} {
		reverse_proxy {{ svc.scheme }}://{{ svc.backend_ipv4 }}:{{ route.port }}
	}
{% endfor %}
	handle {
		reverse_proxy {{ svc.scheme }}://{{ svc.backend_ipv4 }}:{{ svc.port }}
	}
}

{% endfor %}

{% else %}

# One wildcard certificate for the whole namespace. DNS-01 writes exactly one
# TXT record at _acme-challenge.{{ caddy_public_domain }} and removes it after
# validation. No other name in ptxe.dev is ever touched.
#
# Adding a service below needs no new certificate issuance.
*.{{ caddy_public_domain }} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

{% for name, svc in hlac.public_services | dictsort %}
    # {{ svc.description | default(name) }} -> {{ svc.backend }}
    @{{ name }} host {{ name }}.{{ caddy_public_domain }}
    handle @{{ name }} {
        reverse_proxy {{ svc.scheme | default('http') }}://{{ svc.backend_ipv4 }}:{{ svc.port }}
    }
{% endfor %}

	# Anything not declared in the registry gets a clear answer rather than
	# falling through to whichever backend happens to be first.
	handle {
		respond "No such service" 404
	}
}
{% endif %}

# Metrics on their own port. The admin API also serves them, but let's keep it
# locked down :)
:9180 {
	metrics /metrics
}
