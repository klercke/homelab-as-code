# Managed by Ansible. Generated from registries/models.yaml.
model_list:
{% for name, m in llm_models.models | dictsort %}
  - model_name: "{{ name }}"
    litellm_params:
      # llama-swap speaks the OpenAI API and selects the model by this name
      model: "openai/{{ name }}"
      api_base: "{{ llm_models.workers[m.worker].url }}/v1"
      api_key: "none"
{% endfor %}
{% for name, e in llm_models.embeddings | dictsort %}
  - model_name: "{{ name }}"
    litellm_params:
      model: "openai/{{ name }}"
      api_base: "http://127.0.0.1:{{ llm_embed_port }}/v1"
      api_key: "none"
      # BerriAI/litellm#25388. Drop once the pinned version has the fix
      encoding_format: "float"
    model_info:
      mode: "embedding"
{% endfor %}
{% for name, c in llm_models.cloud | dictsort %}
  - model_name: "{{ name }}"
    litellm_params:
      model: "{{ c.model }}"
      api_key: "os.environ/{{ c.api_key_env }}"
{% endfor %}

litellm_settings:
  # Clients send params some backends reject; drop them instead of erroring
  drop_params: true
  # Huginn's persona for every client key; see files/persona.py
  callbacks: persona.proxy_handler_instance

# Tools for every key. Clients call them through LiteLLM's /mcp endpoint.
mcp_servers:
  # Hosted by Pirate Weather. The API key rides in the URL, so the whole URL
  # lives in litellm.env and stays out of this file.
  pirate_weather:
    url: "os.environ/PIRATE_WEATHER_MCP_URL"
    transport: "http"
    # Keys see no MCP servers unless granted. Weather is harmless, so every
    # key gets it. Grant anything sensitive per key instead.
    allow_all_keys: true
    # Every tool schema costs context on each request, and a long overlapping
    # list makes small local models pick badly. These cover current conditions,
    # forecasts and alerts.
    allowed_tools:
      - "get_weather_summary"
      - "get_forecast"
      - "get_hourly_forecast"
      - "get_daily_forecast"
      - "get_alerts"
      - "get_historical_weather"

general_settings:
  master_key: "os.environ/LITELLM_MASTER_KEY"
  database_url: "os.environ/DATABASE_URL"
