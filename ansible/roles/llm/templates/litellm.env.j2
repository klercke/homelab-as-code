# Managed by Ansible. Local changes will be overwritten.
LITELLM_MASTER_KEY={{ litellm_master_key }}
# Encrypts provider credentials stored in the database. Never rotate it once
# keys have been added through the UI, or they become unreadable.
LITELLM_SALT_KEY={{ litellm_salt_key }}
DATABASE_URL=postgresql://litellm:{{ postgres_litellm_password }}@{{ llm_postgres_host }}:5432/litellm
{% for env in llm_models.cloud.values() | map(attribute='api_key_env') | unique | sort %}
{{ env }}={{ vars[env | lower] }}
{% endfor %}
