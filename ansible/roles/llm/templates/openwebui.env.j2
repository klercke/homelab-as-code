# Managed by Ansible. Local changes will be overwritten.
#
# Most Open WebUI settings are only read from the environment on first start,
# then live in its database. Change them in the admin UI after that.
DATABASE_URL=postgresql://openwebui:{{ postgres_openwebui_password }}@{{ llm_postgres_host }}:5432/openwebui
WEBUI_SECRET_KEY={{ openwebui_secret_key }}
WEBUI_URL=https://chat.{{ llm_public_domain }}
PORT={{ llm_openwebui_port }}

# LiteLLM is the only backend. Open WebUI gets a scoped, budgeted key; the
# master key never leaves litellm.env.
ENABLE_OLLAMA_API=false
OPENAI_API_BASE_URL=http://127.0.0.1:{{ llm_litellm_port }}/v1
OPENAI_API_KEY={{ litellm_openwebui_key }}

# Without this Open WebUI loads a local embedding model into RAM on startup
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=http://127.0.0.1:{{ llm_litellm_port }}/v1
RAG_OPENAI_API_KEY={{ litellm_openwebui_key }}
RAG_EMBEDDING_MODEL={{ llm_models.embeddings.keys() | first }}

# Accounts are created by an admin. Like most settings these only apply to a
# fresh database; on an existing one, also turn signups off in the admin UI.
# Lets the gateway's persona hook address each user by name (local models only)
ENABLE_FORWARD_USER_INFO_HEADERS=true

ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending

# Default for new chats: local, so cloud models are opt-in per chat
DEFAULT_MODELS={{ llm_openwebui_default_model }}

# Web search through SearXNG on loopback. Open WebUI appends the query string.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://127.0.0.1:{{ llm_searxng_port }}/search
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=5
# Chunk and embed fetched pages, so only the relevant parts reach the model
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=false
