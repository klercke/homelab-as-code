# Managed by Ansible.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}
  external_labels:
    site: "hme"

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

{% for name, job in monitoring_scrape_jobs | dictsort %}
  # Targets and labels come from the registries. Prometheus watches this
  # directory, so a new host needs no config change here.
  - job_name: {{ name }}
    file_sd_configs:
      - files: ["/etc/prometheus/targets/{{ name }}.yml"]
{% endfor %}

{% if monitoring_printers %}

  # prusa_exporter runs on this host, see tasks/prusa.yml.
  # PrusaLink is polled at scrape time, so it gets a slow interval and a long timeout.
  - job_name: prusalink
    scrape_interval: 60s
    scrape_timeout: 30s
    metrics_path: /metrics/prusalink
    static_configs:
      - targets: ["localhost:{{ prusa_exporter_port }}"]
        labels:
          role: "printer"
          crit: "4"
          kind: "device"

  # Printers push UDP metrics continuously and the exporter keeps the latest value.
  # The dashboard uses changes(...[30s]), so this has to stay well under 30s.
  - job_name: prusa-udp
    scrape_interval: 5s
    metrics_path: /metrics/udp
    static_configs:
      - targets: ["localhost:{{ prusa_exporter_port }}"]
        labels:
          role: "printer"
          crit: "4"
          kind: "device"
{% endif %}
