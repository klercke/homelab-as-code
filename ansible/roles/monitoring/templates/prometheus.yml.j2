# Managed by Ansible.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}
  external_labels:
    site: "hme"

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

{% for name, job in monitoring_scrape_jobs | dictsort %}
  # Targets and labels come from the registries. Prometheus watches this
  # directory, so a new host needs no config change here.
  - job_name: {{ name }}
    file_sd_configs:
      - files: ["/etc/prometheus/targets/{{ name }}.yml"]
{% endfor %}
