# Managed by Ansible. Generated from ansible/group_vars/all/hlac.json.
#
# Every target carries role, layer, and crit labels, so dashboards group by
# role and alert routing can key off criticality without a second source.
{% for hname, h in hlac.hosts | dictsort %}
{% if not job.roles or h.role in job.roles %}
- targets:
    - "{{ h.ipv4 }}:{{ job.port }}"
  labels:
    instance: "{{ hname }}"
    role: "{{ h.role }}"
    layer: "{{ h.layer }}"
    crit: "{{ h.crit }}"
    kind: "vm"
{% endif %}
{% endfor %}
{% if job_name == 'node' %}
{% for dname, d in hlac.devices | dictsort %}
