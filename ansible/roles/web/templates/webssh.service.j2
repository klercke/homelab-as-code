# Managed by Ansible.
[Unit]
Description=webssh, the klercke.com terminal over SSH
After=network-online.target
Wants=network-online.target
# Until CI's first deploy there's no binary, stay inactive instead of failing.
ConditionPathExists={{ web_webssh_root }}/webssh

[Service]
ExecStart={{ web_webssh_root }}/webssh
Restart=on-failure
RestartSec=5

# Throwaway user; the only writable path is StateDirectory (its host key).
DynamicUser=yes
StateDirectory=webssh
StateDirectoryMode=0700
UMask=0077

# Bind port 22 without root, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SocketBindAllow=tcp:22
SocketBindDeny=any

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
