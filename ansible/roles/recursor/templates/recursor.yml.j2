# Managed by Ansible.
incoming:
  listen:
    - {{ ansible_host }}
  port: 53
  allow_from:
    - {{ recursor_allow_from }}

recursor:
  forward_zones:
{% for zone in recursor_internal_zones %}
    - zone: {{ zone }}
      forwarders:
{% for ip in recursor_auth_targets %}
        - {{ ip }}
{% endfor %}
{% endfor %}
{% for zone in recursor_reverse_zones %}
    - zone: {{ zone }}
      forwarders:
{% for ip in recursor_auth_targets %}
        - {{ ip }}
{% endfor %}
{% endfor %}

dnssec:
  validation: validate
  negative_trustanchors:
{% for zone in recursor_internal_zones %}
    - name: {{ zone }}
      reason: "internally served, unsigned"
{% endfor %}
{% for zone in recursor_reverse_zones %}
    - name: {{ zone }}
      reason: "internal unsigned reverse zone"
{% endfor %}

webservice:
  webserver: true
  address: {{ ansible_host }}
  port: 8082
  allow_from:
    - 10.0.10.213/32  # thor
    - 10.0.20.20/32   # monitoring01

logging:
  loglevel: 4
