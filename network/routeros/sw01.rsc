# sw01.rsc
# Not yet generated by code, but we're pretending it was
:delay 15s

/system identity set name=sw01
/system clock set time-zone-name=America/New_York
/system ntp client set enabled=yes servers=0.pool.ntp.org,1.pool.ntp.org

/interface ethernet
set [find default-name=ether1] disabled=no comment="patch01-01 fw01:opt1"
set [find default-name=ether2] disabled=no comment="patch02-02 fw01:lan"
set [find default-name=ether3] disabled=yes
set [find default-name=ether4] disabled=yes
set [find default-name=ether5] disabled=no comment="patch01-05 pve01:nic0"
set [find default-name=ether6] disabled=yes comment="patch01-06 pve01:nic1"
set [find default-name=ether7] disabled=no comment="patch01-07 pve02:port0"
set [find default-name=ether8] disabled=yes comment="patch01-08 pve02:port1"
set [find default-name=ether9] disabled=yes
set [find default-name=ether10] disabled=yes
set [find default-name=ether11] disabled=yes
set [find default-name=ether12] disabled=yes
set [find default-name=ether13] disabled=no comment="patch01-13 nas01:nic0"
set [find default-name=ether14] disabled=no comment="patch01-14 nas01:nic1"
set [find default-name=ether15] disabled=no comment="patch01-15 pbs01:eth0"
set [find default-name=ether16] disabled=yes comment="patch01-16 pbs01:eth1"
set [find default-name=ether17] disabled=yes comment="patch01-17 pve01:bmc"
set [find default-name=ether18] disabled=no comment="patch01-18 pve02:bmc"
set [find default-name=ether19] disabled=yes comment="patch01-19 pbs01:bmc"
set [find default-name=ether20] disabled=yes comment="patch01-20 nas01:bmc"
set [find default-name=ether21] disabled=no comment="patch01-21 laptop01:eth0"
set [find default-name=ether22] disabled=yes
set [find default-name=ether23] disabled=no comment="patch01-23 homeassistant:eth0"
set [find default-name=ether24] disabled=no comment="sw02:port1 TEMP mgmt"
set [find default-name=ether25] disabled=yes
set [find default-name=ether26] disabled=yes
set [find default-name=ether27] disabled=yes
set [find default-name=ether28] disabled=yes
set [find default-name=ether29] disabled=yes
set [find default-name=ether30] disabled=yes
set [find default-name=ether31] disabled=yes
set [find default-name=ether32] disabled=yes
set [find default-name=ether33] disabled=yes
set [find default-name=ether34] disabled=yes
set [find default-name=ether35] disabled=yes
set [find default-name=ether36] disabled=yes
set [find default-name=ether37] disabled=yes
set [find default-name=ether38] disabled=yes
set [find default-name=ether39] disabled=yes
set [find default-name=ether40] disabled=yes
set [find default-name=ether41] disabled=yes
set [find default-name=ether42] disabled=yes
set [find default-name=ether43] disabled=yes
set [find default-name=ether44] disabled=yes
set [find default-name=ether45] disabled=yes
set [find default-name=ether46] disabled=yes
set [find default-name=ether47] disabled=yes
set [find default-name=ether48] disabled=yes
set [find default-name=ether49] disabled=no comment="oob"
set [find default-name=sfp-sfpplus1] disabled=no comment="sw02:sfp1"
set [find default-name=sfp-sfpplus2] disabled=no comment="thor:sfp0"
set [find default-name=sfp-sfpplus3] disabled=yes comment="desksw01:sfp1"
set [find default-name=sfp-sfpplus4] disabled=yes comment="desksw01:sfp2"
set [find default-name=qsfpplus1-1] disabled=yes
set [find default-name=qsfpplus1-2] disabled=yes
set [find default-name=qsfpplus1-3] disabled=yes
set [find default-name=qsfpplus1-4] disabled=yes
set [find default-name=qsfpplus2-1] disabled=yes
set [find default-name=qsfpplus2-2] disabled=yes
set [find default-name=qsfpplus2-3] disabled=yes
set [find default-name=qsfpplus2-4] disabled=yes

/ip address
add address=10.0.254.2/24 interface=ether49 comment="oob"

/interface bonding
add name=bond-nas01 mode=802.3ad slaves=ether13,ether14 lacp-rate=1sec transmit-hash-policy=layer-2-and-3 comment="nas01"

/interface bridge
add name=bridge1 protocol-mode=rstp priority=0x1000 vlan-filtering=no frame-types=admit-only-vlan-tagged

/interface bridge port
add bridge=bridge1 interface=ether1 frame-types=admit-only-vlan-tagged comment="fw01:opt1"
add bridge=bridge1 interface=ether2 pvid=1 frame-types=admit-only-untagged-and-priority-tagged edge=yes comment="fw01:lan"
add bridge=bridge1 interface=ether5 pvid=160 comment="pve01:nic0"
add bridge=bridge1 interface=ether7 pvid=160 comment="pve02:port0"
add bridge=bridge1 interface=bond-nas01 pvid=120 frame-types=admit-only-untagged-and-priority-tagged edge=yes comment="nas01"
add bridge=bridge1 interface=ether15 pvid=120 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="pbs01:eth0"
add bridge=bridge1 interface=ether17 pvid=160 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="pve01:bmc"
add bridge=bridge1 interface=ether18 pvid=160 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="pve02:bmc"
add bridge=bridge1 interface=ether19 pvid=160 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="pbs01:bmc"
add bridge=bridge1 interface=ether20 pvid=160 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="nas01:bmc"
add bridge=bridge1 interface=ether23 pvid=120 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="homeassistant:eth0"
add bridge=bridge1 interface=ether21 pvid=110 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="laptop01:eth0"
add bridge=bridge1 interface=sfp-sfpplus1 frame-types=admit-only-vlan-tagged comment="sw02:sfp1"
# TEMP: sw02 + AP management on untagged VLAN 1 until moved to MANAGEMENT
add bridge=bridge1 interface=ether24 pvid=1 frame-types=admit-only-untagged-and-priority-tagged comment="sw02:port1 TEMP mgmt"
add bridge=bridge1 interface=sfp-sfpplus2 pvid=110 frame-types=admit-only-untagged-and-priority-tagged edge=yes bpdu-guard=yes comment="thor:sfp0"

/interface bridge vlan
  # TEMP: legacy LAN only carries sw02 + AP management; remove with ether2 once they're on MANAGEMENT
add bridge=bridge1 vlan-ids=1 untagged=ether2,ether24 comment="LAN"
add bridge=bridge1 vlan-ids=110 tagged=ether1,ether5,ether7,sfp-sfpplus1 untagged=ether21,sfp-sfpplus2 comment="CLIENTS"
add bridge=bridge1 vlan-ids=120 tagged=ether1,ether5,ether7,sfp-sfpplus1 untagged=bond-nas01,ether15,ether23 comment="SERVERS"
add bridge=bridge1 vlan-ids=130 tagged=ether1,ether5,ether7,sfp-sfpplus1 comment="IOT"
add bridge=bridge1 vlan-ids=140 tagged=ether1,ether5,ether7,sfp-sfpplus1 comment="LAB"
add bridge=bridge1 vlan-ids=150 tagged=ether1,ether5,ether7,sfp-sfpplus1 comment="GUEST"
add bridge=bridge1 vlan-ids=160 tagged=bridge1,ether1,sfp-sfpplus1 untagged=ether5,ether7,ether17,ether18,ether19,ether20 comment="MANAGEMENT"
add bridge=bridge1 vlan-ids=170 tagged=ether1,ether5,ether7 comment="DMZ"

/interface vlan
add interface=bridge1 name=vlan160-mgmt vlan-id=160 comment="MANAGEMENT"

/interface list
add name=MGMT
add name=DISCOVERY
/interface list member
add list=MGMT interface=vlan160-mgmt
add list=MGMT interface=ether49
add list=DISCOVERY interface=vlan160-mgmt
add list=DISCOVERY interface=ether1
add list=DISCOVERY interface=ether2
add list=DISCOVERY interface=ether5
add list=DISCOVERY interface=ether7
add list=DISCOVERY interface=ether13
add list=DISCOVERY interface=ether14
add list=DISCOVERY interface=ether15
add list=DISCOVERY interface=sfp-sfpplus1

/ip address
add address=10.0.60.11/24 interface=vlan160-mgmt comment="MANAGEMENT"
/ip route
add dst-address=0.0.0.0/0 gateway=10.0.60.1
/ip dns
set servers=10.0.20.16,10.0.20.17

/ipv6 settings set forward=no
/ipv6 address
add address=2603:7083:4600:103c::b/64 advertise=no interface=vlan160-mgmt comment="MANAGEMENT"
/ipv6 nd set [find default=yes] disabled=yes
/ipv6 firewall filter
add chain=input action=drop protocol=icmpv6 icmp-options=134:0-255 in-interface=ether49 comment="oob"

/ip service
set telnet disabled=yes
set ftp disabled=yes
set www disabled=yes
set www-ssl disabled=yes
set api disabled=yes
set api-ssl disabled=yes
set ssh available-from=10.0.60.0/24,10.0.254.0/24,10.0.10.213/32,2603:7083:4600:103c::/64
set winbox available-from=10.0.60.0/24,10.0.254.0/24,10.0.10.213/32,2603:7083:4600:103c::/64
/ip ssh set strong-crypto=yes host-key-type=ed25519
/user ssh-keys remove [find user=admin]
/user ssh-keys add user=admin key="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMlg7RCLSsR+yQA4EckheXWKXHiHLduZ3mBqwrSwvnmX protonet-admin"
/tool bandwidth-server set enabled=no
/tool mac-server set allowed-interface-list=none
/tool mac-server mac-winbox set allowed-interface-list=MGMT
/ip neighbor discovery-settings set discover-interface-list=DISCOVERY

/interface bridge set bridge1 vlan-filtering=yes
